									"</style>",
									"",
									"<table class=\"tftable\" border=\"1\">",
									"    <tr>",
									"        <th>ID</th>",
									"        <th>Name</th>",
									"        <th>Species</th>",
									"        <th>Age</th>",
									"        <th>Breed</th>",
									"        <th>Gender</th>",
									"        <th>Status</th>",
									"        <th>Weight</th>",
									"        <th>Color</th>",
									"        <th>Description</th>",
									"        <th>Image URL</th>",
									"        <th>Vaccinated</th>",
									"        <th>Neutered</th>",
